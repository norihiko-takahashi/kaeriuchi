# 社用の AWS アカウントで、本物の Bedrock につなぐときの設定の例（秘密の値は入れない）
# 使い方：cp .env.company.example .env.local
# 認証情報は ~/.aws/config のプロファイル（できれば SSO）に置く。ここには書かない。
AI_PROVIDER=bedrock
AWS_PROFILE=company
AWS_REGION=ap-northeast-1
# 東京リージョンで使えるモデル ID を入れる（"apac." "global." "jp." で始まる、リージョンをまたぐものは使えない）
BEDROCK_MODEL_ANALYZE=
BEDROCK_MODEL_GENERATE=
BEDROCK_MODEL_VERIFY=
BEDROCK_MODEL_GRADE=
BEDROCK_LOG_RETENTION_MAX_DAYS=30
